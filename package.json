{
  "name": "folio",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@tesseract.js-data/spa": "1.0.0",
    "tesseract.js": "7.0.0"
  },
